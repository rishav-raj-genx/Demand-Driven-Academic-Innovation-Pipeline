# ==============================================================================
# SIH26043 - Demand-Driven Academic Innovation Pipeline
# Environment Variables Configuration
# ==============================================================================

# General
NODE_ENV=development
PORT=3000

# PostgreSQL with PostGIS & pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_DB=sih26043_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password_dev@localhost:5432/sih26043_db?schema=public

# Redis Cache & Message Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO / S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sih26043-media
S3_FORCE_PATH_STYLE=true

# Auth & JWT Configuration
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min_32_chars
JWT_REFRESH_EXPIRY=7d

# Internal Service Security & AI Engine
INTERNAL_AI_SERVICE_KEY=dev_internal_ai_service_secret_key
AI_ENGINE_URL=http://localhost:8000
