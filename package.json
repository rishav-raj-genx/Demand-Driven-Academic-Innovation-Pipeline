{
  "name": "sih26043-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:pipeline": "tsx --tsconfig apps/web/tsconfig.json scripts/verify-worker-pipeline.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
