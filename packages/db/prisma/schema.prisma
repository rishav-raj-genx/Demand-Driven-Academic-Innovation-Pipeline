datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ============================================================================
// Enums
// ============================================================================

enum UserRole {
  STUDENT
  FACULTY
  RESEARCHER
  INSTITUTION_ADMIN
  INDUSTRY_PARTNER
  INVESTOR
  CSR_PARTNER
  SUPER_ADMIN
  CITIZEN
  GOVT_OFFICIAL

  @@map("user_roles")
}

enum InstitutionTier {
  TIER_1
  TIER_2
  TIER_3
  UNACCREDITED

  @@map("institution_tiers")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@map("verification_statuses")
}

enum ChallengeStatus {
  DRAFT
  SUBMITTED
  OPEN
  UNDER_REVIEW
  MATCHED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
  DUPLICATE_MERGED

  @@map("challenge_statuses")
}

enum ProjectPhase {
  POC
  PROTOTYPING
  FIELD_TEST
  IP_TECH_TRANSFER

  @@map("project_phases")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REQUESTED_CHANGES
  PENDING

  @@map("approval_decisions")
}

enum CsrEntryStatus {
  SUBMITTED
  ELIGIBLE
  INELIGIBLE
  ALLOCATED
  DISBURSED

  @@map("csr_entry_statuses")
}

// ============================================================================
// Domain Models (15 Models)
// ============================================================================

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  email              String             @unique
  passwordHash       String             @map("password_hash")
  fullName           String             @map("full_name")
  role               UserRole           @default(STUDENT)
  phoneNumber        String?            @map("phone_number")
  avatarUrl          String?            @map("avatar_url")
  isEmailVerified    Boolean            @default(false) @map("is_email_verified")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")

  // Affiliations
  institutionId     String?          @map("institution_id") @db.Uuid
  institution       Institution?     @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  industryPartnerId String?          @map("industry_partner_id") @db.Uuid
  industryPartner   IndustryPartner? @relation(fields: [industryPartnerId], references: [id], onDelete: SetNull)

  // Reverse Relations
  refreshTokens     RefreshToken[]
  createdChallenges Challenge[]       @relation("ChallengeCreator")
  projectMembers    ProjectMember[]
  phaseApprovals    PhaseApproval[]
  auditLogs         AuditLog[]
  notificationLogs  NotificationLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([role])
  @@index([institutionId])
  @@index([industryPartnerId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model District {
  id        String                                       @id @default(uuid()) @db.Uuid
  name      String
  state     String
  code      String                                       @unique
  boundary  Unsupported("geometry(MultiPolygon, 4326)")?
  centroid  Unsupported("geometry(Point, 4326)")?

  institutions     Institution[]
  industryPartners IndustryPartner[]
  challenges       Challenge[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([boundary], type: Gist, map: "idx_districts_boundary_gist")
  @@index([centroid], type: Gist, map: "idx_districts_centroid_gist")
  @@index([name])
  @@index([state])
  @@map("districts")
}

model Institution {
  id                  String                                @id @default(uuid()) @db.Uuid
  name                String
  code                String                                @unique
  tier                InstitutionTier                       @default(TIER_3)
  districtId          String?                               @map("district_id") @db.Uuid
  district            District?                             @relation(fields: [districtId], references: [id], onDelete: SetNull)
  address             String?
  website             String?
  contactEmail        String?                               @map("contact_email")
  contactPhone        String?                               @map("contact_phone")
  verificationStatus  VerificationStatus                    @default(PENDING) @map("verification_status")
  location            Unsupported("geometry(Point, 4326)")?
  capabilityEmbedding Unsupported("vector(384)")?          @map("capability_embedding")
  activeProjects      Int                                   @default(0) @map("active_projects")
  maxCapacity         Int                                   @default(10) @map("max_capacity")
  domains             String[]                              @default([])
  facultySpecializations String[]                           @default([]) @map("faculty_specializations")
  labFacilities         String[]                            @default([]) @map("lab_facilities")
  profileSummary        String?                             @map("profile_summary") @db.Text

  users             User[]
  capabilityMatches CapabilityMatch[]
  projects          Project[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([location], type: Gist, map: "idx_institutions_location_gist")
  @@index([capabilityEmbedding], map: "idx_institutions_embedding_hnsw")
  @@index([name])
  @@index([tier])
  @@index([districtId])
  @@map("institutions")
}

model IndustryPartner {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationName   String             @map("organization_name")
  cin                String?            @unique
  industrySector     String             @map("industry_sector")
  districtId         String?            @map("district_id") @db.Uuid
  district           District?          @relation(fields: [districtId], references: [id], onDelete: SetNull)
  website            String?
  contactEmail       String?            @map("contact_email")
  contactPhone       String?            @map("contact_phone")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")

  users            User[]
  challenges       Challenge[]
  projects         Project[]
  csrLedgerEntries CsrLedgerEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationName])
  @@index([industrySector])
  @@index([districtId])
  @@map("industry_partners")
}

model Challenge {
  id                   String                                @id @default(uuid()) @db.Uuid
  title                String
  problemStatement     String                                @map("problem_statement") @db.Text
  domain               String?
  urgency              String                                @default("MEDIUM")
  districtId           String?                               @map("district_id") @db.Uuid
  district             District?                             @relation(fields: [districtId], references: [id], onDelete: SetNull)
  industryPartnerId    String?                               @map("industry_partner_id") @db.Uuid
  industryPartner      IndustryPartner?                      @relation(fields: [industryPartnerId], references: [id], onDelete: SetNull)
  createdById          String                                @map("created_by_id") @db.Uuid
  createdBy            User                                  @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status               ChallengeStatus                       @default(OPEN)
  category             String?
  budgetRange          Decimal?                              @map("budget_range") @db.Decimal(14, 2)
  currency             String                                @default("INR")
  location             Unsupported("geometry(Point, 4326)")?
  embedding            Unsupported("vector(384)")?
  clientIdempotencyKey String?                               @unique @map("client_idempotency_key")
  mediaKeys            String[]                              @default([]) @map("media_keys")
  endorsementCount     Int                                   @default(0) @map("endorsement_count")
  canonicalId          String?                               @map("canonical_id") @db.Uuid
  canonicalChallenge   Challenge?                            @relation("ChallengeDuplicates", fields: [canonicalId], references: [id], onDelete: SetNull)
  duplicateChallenges  Challenge[]                           @relation("ChallengeDuplicates")
  deadline             DateTime?

  capabilityMatches CapabilityMatch[]
  projects          Project[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([location], type: Gist, map: "idx_challenges_location_gist")
  @@index([embedding], map: "idx_challenges_embedding_hnsw")
  @@index([districtId])
  @@index([industryPartnerId])
  @@index([createdById])
  @@index([status])
  @@index([canonicalId])
  @@map("challenges")
}

model CapabilityMatch {
  id              String      @id @default(uuid()) @db.Uuid
  challengeId     String      @map("challenge_id") @db.Uuid
  challenge       Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  institutionId   String      @map("institution_id") @db.Uuid
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  similarityScore Float       @map("similarity_score")
  matchRank       Int?        @map("match_rank")
  status          String      @default("SUGGESTED")
  feedback        String?     @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([challengeId, institutionId])
  @@index([challengeId])
  @@index([institutionId])
  @@index([similarityScore])
  @@map("capability_matches")
}

model Project {
  id                   String          @id @default(uuid()) @db.Uuid
  title                String
  description          String?         @db.Text
  challengeId          String?         @map("challenge_id") @db.Uuid
  challenge            Challenge?      @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  institutionId        String          @map("institution_id") @db.Uuid
  institution          Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  industryPartnerId    String          @map("industry_partner_id") @db.Uuid
  industryPartner      IndustryPartner @relation(fields: [industryPartnerId], references: [id], onDelete: Restrict)
  currentPhase         ProjectPhase    @default(POC) @map("current_phase")
  startDate            DateTime?       @map("start_date")
  targetCompletionDate DateTime?       @map("target_completion_date")
  budget               Decimal?        @db.Decimal(14, 2)

  projectMembers   ProjectMember[]
  milestones       Milestone[]
  mous             MoU[]
  csrLedgerEntries CsrLedgerEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([challengeId])
  @@index([institutionId])
  @@index([industryPartnerId])
  @@index([currentPhase])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("RESEARCHER")
  joinedAt  DateTime @default(now()) @map("joined_at")

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Milestone {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?          @db.Text
  phase       ProjectPhase     @default(POC)
  orderIndex  Int              @default(0) @map("order_index")
  dueDate     DateTime?        @map("due_date")
  status      ApprovalDecision @default(PENDING)
  isCompleted Boolean          @default(false) @map("is_completed")
  completedAt DateTime?        @map("completed_at")

  phaseApprovals PhaseApproval[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([phase])
  @@map("milestones")
}

model PhaseApproval {
  id          String           @id @default(uuid()) @db.Uuid
  milestoneId String           @map("milestone_id") @db.Uuid
  milestone   Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  signerId    String           @map("signer_id") @db.Uuid
  signer      User             @relation(fields: [signerId], references: [id], onDelete: Restrict)
  signerRole  UserRole         @map("signer_role")
  decision    ApprovalDecision @default(PENDING)
  remarks     String?          @db.Text
  signedAt    DateTime         @default(now()) @map("signed_at")

  @@unique([milestoneId, signerId])
  @@unique([milestoneId, signerRole])
  @@index([milestoneId])
  @@index([signerId])
  @@map("phase_approvals")
}

model MoU {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentUrl String    @map("document_url")
  status      String    @default("DRAFT")
  ipTerms     String?   @map("ip_terms") @db.Text
  signedDate  DateTime? @map("signed_date")
  expiryDate  DateTime? @map("expiry_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("mous")
}

model CsrLedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  projectId        String          @map("project_id") @db.Uuid
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partnerId        String          @map("partner_id") @db.Uuid
  partner          IndustryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  amount           Decimal         @db.Decimal(14, 2)
  status           CsrEntryStatus  @default(SUBMITTED)
  transactionRef   String?         @map("transaction_ref")
  disbursementDate DateTime?       @map("disbursement_date")
  remarks          String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([partnerId])
  @@index([status])
  @@map("csr_ledger_entries")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model NotificationLog {
  id          String   @id @default(uuid()) @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  message     String   @db.Text
  type        String   @default("INFO")
  isRead      Boolean  @default(false) @map("is_read")
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notification_logs")
}
